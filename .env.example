# Development defaults. Copy to .env; never commit credential values.
NODE_ENV=development
PORT=5000
DB_ENGINE=local
# Required in production: generate a random secret of at least 32 characters.
JWT_SECRET=
# Production DB_ENGINE: mongodb | postgres | mysql
# MongoDB only:
MONGO_URI=
DB_NAME=forge
# SQL only: postgresql://user:password@host:5432/db or mysql://user:password@host:3306/db
DATABASE_URL=
DB_SSL=false
# Optional mounted CA for verified SQL TLS:
DB_SSL_CA_PATH=
# Optional cross-origin browser clients; same-origin UI needs no setting.
CORS_ORIGINS=
# Cloud Run ingress proxy; change only for a known proxy topology.
TRUST_PROXY_HOPS=1
# Optional local test/development file location. Never use local storage in production.
# LOCAL_DB_PATH=/tmp/devmatrix-local/db.json
# Optional real operations: non-secret JSON mapping workspace IDs to approved targets.
# Configure this in Cloud Run; see docs/OPERATIONS.md for the full schema and IAM.
DEPLOYMENT_TARGETS_JSON={}
